.vite/

# Electron-Forge
out/

# Web build intermediate output — the deploy scripts copy the final
# artifacts, so the staging dirs are ignored. landing/home/demo is where
# web-deploy still places the SPA — the site no longer publishes it (the
# in-browser demo was removed from the website), so it never reaches docs/.
dist-web/
landing/home/demo/

# Landing site (Vite) intermediate output — scripts/landing-deploy.mjs copies
# the final artifacts into docs/ (committed), so the staging dir is ignored.
# NOTE: only the build output below is ignored. The marketing SOURCE —
# landing/public/ (incl. /newhomescreen), landing/src/ — and the deployed
# docs/ mirror are tracked and DO commit. Don't add a broad `landing/`.
landing/dist/

# Per-machine local project registry written at runtime (project id → folder
# path). Machine-specific; lives in ~/Documents/Docvex but can land here in dev.
.docvex-projects.json
